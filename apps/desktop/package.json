{
  "name": "@atv-design/desktop",
  "version": "0.1.4",
  "productName": "ATV Design",
  "appId": "com.atv-design.desktop",
  "author": "ATV Design Contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "files": ["build", "out", "resources", "scripts", "electron-builder.yml", "package.json"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/All-The-Vibes/ATV-Design.git"
  },
  "scripts": {
    "postinstall": "node scripts/install-sqlite-bindings.cjs",
    "dev": "node scripts/dev.cjs",
    "build": "node scripts/build-staged.cjs",
    "build:dir": "node scripts/build-staged.cjs --dir --x64",
    "release": "node scripts/build-staged.cjs --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && node scripts/e2e-run.cjs",
    "test:e2e:norebuild": "node scripts/e2e-run.cjs",
    "test:e2e:headed": "node scripts/e2e-run.cjs --headed",
    "test:e2e:ui": "node scripts/e2e-run.cjs --ui"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "better-sqlite3": "^12.9.0",
    "electron-log": "^5",
    "electron-updater": "^6.3.9",
    "ieee754": "^1.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "smol-toml": "^1.6.1",
    "zip-lib": "^1.0.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@atv-design/artifacts": "workspace:*",
    "@atv-design/core": "workspace:*",
    "@atv-design/exporters": "workspace:*",
    "@atv-design/i18n": "workspace:*",
    "@atv-design/providers": "workspace:*",
    "@atv-design/runtime": "workspace:*",
    "@atv-design/shared": "workspace:*",
    "@atv-design/templates": "workspace:*",
    "@atv-design/ui": "workspace:*",
    "@playwright/test": "1.52.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "1.52.0",
    "playwright-core": "1.52.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.5"
  }
}
