{
  "name": "aperture-card-os",
  "description": "Apple-inspired credit card banking design tokens; not affiliated with Apple Inc.",
  "color": {
    "canvas": "#F4F1EA",
    "surface": "#FFFCF4",
    "ink": "#20211F",
    "muted": "#6E716B",
    "hairline": "#D9D4C8",
    "graphite": "#101312",
    "phosphor": "#BDF7A8",
    "copper": "#C6A36F",
    "warning": "#9A4A34",
    "success": "#2F6B4F"
  },
  "typography": {
    "ui": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif",
    "mono": "'SF Mono', ui-monospace, 'Cascadia Code', monospace",
    "videoDisplay": "Newsreader, Georgia, serif",
    "videoMono": "'IBM Plex Mono', 'Cascadia Code', monospace"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 72 },
  "radius": { "control": 12, "card": 28, "sheet": 36, "round": 999 },
  "stroke": { "hairline": 1, "focus": 2 },
  "motion": {
    "controlMs": [160, 220],
    "panelMs": [320, 480],
    "heroMs": [700, 900],
    "easeEnter": "expo.out",
    "easePulse": "sine.inOut",
    "easeWipe": "power4.inOut"
  }
}
