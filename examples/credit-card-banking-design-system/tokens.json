{
  "name": "vaultline-card",
  "description": "Design tokens for a fictional credit-card banking app design system.",
  "schemaVersion": 1,
  "primitive": {
    "color": {
      "limestone50": "#F8F4EA",
      "limestone100": "#EFE7D7",
      "paper0": "#FFFDF7",
      "basalt900": "#171A18",
      "basalt700": "#343833",
      "basalt500": "#687066",
      "brass500": "#A98046",
      "mint400": "#9FE6BD",
      "blueprint500": "#3F6F9F",
      "clay600": "#A24B36",
      "rose600": "#8F334A",
      "line200": "#DDD3BF"
    },
    "font": {
      "display": "Fraunces, Georgia, serif",
      "ui": "IBM Plex Sans, Segoe UI, sans-serif",
      "data": "Azeret Mono, Cascadia Code, ui-monospace, monospace"
    },
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 24,
      "6": 32,
      "7": 48,
      "8": 72
    },
    "radius": {
      "control": 14,
      "card": 28,
      "sheet": 36,
      "round": 999
    },
    "stroke": {
      "hairline": 1,
      "focus": 2,
      "rail": 4
    },
    "motion": {
      "fastMs": 160,
      "controlMs": 220,
      "panelMs": 360,
      "heroMs": 640,
      "easeStandard": "cubic-bezier(.2,.8,.2,1)",
      "easeGuard": "cubic-bezier(.16,1,.3,1)"
    }
  },
  "semantic": {
    "color": {
      "bgApp": "{primitive.color.limestone50}",
      "bgSurface": "{primitive.color.paper0}",
      "bgSurfaceMuted": "{primitive.color.limestone100}",
      "textPrimary": "{primitive.color.basalt900}",
      "textSecondary": "{primitive.color.basalt700}",
      "textMuted": "{primitive.color.basalt500}",
      "borderSubtle": "{primitive.color.line200}",
      "accentValue": "{primitive.color.brass500}",
      "stateSecure": "{primitive.color.mint400}",
      "stateInfo": "{primitive.color.blueprint500}",
      "stateWarning": "{primitive.color.clay600}",
      "stateDanger": "{primitive.color.rose600}"
    },
    "typography": {
      "balance": "{primitive.font.data}",
      "heading": "{primitive.font.display}",
      "body": "{primitive.font.ui}",
      "label": "{primitive.font.data}"
    }
  },
  "component": {
    "creditCardHero": {
      "background": "{semantic.color.textPrimary}",
      "text": "{primitive.color.paper0}",
      "edge": "{semantic.color.accentValue}",
      "radius": "{primitive.radius.card}"
    },
    "ledgerRail": {
      "safe": "{semantic.color.stateSecure}",
      "pending": "{semantic.color.stateInfo}",
      "warning": "{semantic.color.stateWarning}",
      "locked": "{semantic.color.stateDanger}",
      "value": "{semantic.color.accentValue}",
      "width": "{primitive.stroke.rail}"
    },
    "guardedAction": {
      "background": "{semantic.color.bgSurface}",
      "border": "{semantic.color.borderSubtle}",
      "radius": "{primitive.radius.control}",
      "focusRing": "{semantic.color.stateSecure}"
    },
    "transactionRow": {
      "background": "{semantic.color.bgSurface}",
      "border": "{semantic.color.borderSubtle}",
      "amountFont": "{semantic.typography.balance}"
    }
  }
}
